# TerraTrace configuration. Copy to `.env` and edit. None of these are secrets —
# the Microsoft Planetary Computer STAC API is open and needs no key.

# --- Inference service ---
TERRATRACE_CHECKPOINT=checkpoints/fast.pt
TERRATRACE_DEVICE=auto        # auto | cpu | mps | cuda
TERRATRACE_TILE_CACHE_DIR=.cache/tiles
TERRATRACE_LOG_LEVEL=INFO

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Data pipeline ---
# Set to 1 to skip the network and force the synthetic data path.
TERRATRACE_FORCE_SYNTHETIC=0
