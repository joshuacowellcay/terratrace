# --- backend Dockerfile (FastAPI inference service) ---
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# rasterio's wheels bundle GDAL, but a couple of runtime libraries help with
# certain GeoTIFF codecs. ca-certificates is required for outbound HTTPS to STAC.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt ./
RUN pip install --upgrade pip && pip install -r requirements.txt

COPY pyproject.toml ./
COPY src ./src
COPY data/sample ./data/sample
COPY checkpoints/fast.pt ./checkpoints/fast.pt
COPY configs ./configs

RUN pip install -e .

EXPOSE 8000

ENV TERRATRACE_CHECKPOINT=/app/checkpoints/fast.pt \
    TERRATRACE_SAMPLE_MANIFEST=/app/data/sample/manifest.json \
    TERRATRACE_TILE_CACHE_DIR=/app/.cache/tiles

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -fsS http://localhost:8000/health || exit 1

CMD ["uvicorn", "terratrace.inference.service:app", "--host", "0.0.0.0", "--port", "8000"]
