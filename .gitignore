# Data — keep only the tiny committed sample
data/*
!data/.gitkeep
!data/sample/
!data/sample/**

# Large rasters anywhere outside data/sample
*.tif
*.tiff
*.nc
*.h5
*.hdf5
*.npz
!data/sample/**/*.tif
!data/sample/**/*.tiff
!data/sample/**/*.npz
!assets/*.png
!assets/*.jpg

# Node / Next
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
next-env.d.ts

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local artifacts
results/
# Commit only the small fast.pt checkpoint that ships with the repo so inference works on a
# fresh clone. Anything else under checkpoints/ (e.g. full.pt from a GPU training run) is
# regenerated locally and stays out of git.
checkpoints/*
!checkpoints/fast.pt
checkpoints_full/
